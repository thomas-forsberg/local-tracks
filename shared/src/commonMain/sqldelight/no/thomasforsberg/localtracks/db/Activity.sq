import kotlin.Boolean;
import kotlin.time.Instant;
import no.thomasforsberg.localtracks.recording.Sport;

CREATE TABLE activity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sport TEXT AS Sport NOT NULL,
    started_at INTEGER AS Instant NOT NULL,
    -- NULL while recording, and after a crash until the activity is resumed or finished.
    finished_at INTEGER AS Instant,
    -- Running totals, updated with every batch of points.
    active_time_ms INTEGER NOT NULL DEFAULT 0,
    distance_meters REAL NOT NULL DEFAULT 0,
    point_count INTEGER NOT NULL DEFAULT 0,
    elevation_gain_meters REAL NOT NULL DEFAULT 0,
    moving_time_ms INTEGER NOT NULL DEFAULT 0,
    -- NULL when steps weren't counted (other sports, no pedometer, older activities).
    step_count INTEGER,
    auto_started INTEGER AS Boolean NOT NULL DEFAULT 0,
    -- The stretch walked before an automatic recording started (no points; included in the totals above).
    lead_in_ms INTEGER,
    lead_in_meters REAL,
    lead_in_steps INTEGER
);

CREATE INDEX activity_started_at ON activity (started_at);

insert:
INSERT INTO activity (sport, started_at, auto_started, lead_in_ms, lead_in_meters, lead_in_steps) VALUES (?, ?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

updateTotals:
UPDATE activity
SET active_time_ms = :activeTimeMs, distance_meters = :distanceMeters, point_count = :pointCount,
    elevation_gain_meters = :elevationGainMeters, moving_time_ms = :movingTimeMs, step_count = :stepCount
WHERE id = :id;

updateMeasurement:
UPDATE activity SET distance_meters = :distanceMeters, moving_time_ms = :movingTimeMs WHERE id = :id;

allIds:
SELECT id, sport, lead_in_ms, lead_in_meters FROM activity;

finish:
UPDATE activity
SET finished_at = :finishedAt, active_time_ms = :activeTimeMs, distance_meters = :distanceMeters, point_count = :pointCount,
    elevation_gain_meters = :elevationGainMeters, moving_time_ms = :movingTimeMs, step_count = :stepCount
WHERE id = :id;

byId:
SELECT * FROM activity WHERE id = ?;

latestUnfinished:
SELECT * FROM activity WHERE finished_at IS NULL ORDER BY started_at DESC LIMIT 1;

finished:
SELECT * FROM activity WHERE finished_at IS NOT NULL ORDER BY started_at DESC;

delete:
DELETE FROM activity WHERE id = ?;
