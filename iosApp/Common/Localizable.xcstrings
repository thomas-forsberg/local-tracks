    "Sporløs is in Norwegian and English and follows your phone's language. Change it for this app in iOS Settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporløs finnes på norsk og engelsk og følger språket på telefonen. Du kan endre det for denne appen i Innstillinger."
          }
        }
      }
    },
    "Sporløs started recording automatically when you left home. It stops when you're back.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporløs startet opptaket automatisk da du dro hjemmefra. Det stopper når du er tilbake."
