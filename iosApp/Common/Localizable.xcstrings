          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        }
      }
    },
    "Start with an overview of Norway (about %@), then download detailed maps of the areas you go to. Maps are from Kartverket and work without a connection.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start med en oversikt over Norge (omtrent %@), og last ned detaljerte kart over områdene du går i. Kartene er fra Kartverket og virker uten nett."
          }
        }
      }
    },
